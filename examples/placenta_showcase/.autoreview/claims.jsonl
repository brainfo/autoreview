_frac_tm", "EVT_frac_tm", "Endothelial_cells_frac_tm", "Hofbauer_cells_frac_tm", "Perivascular_frac_tm", "STB_frac_tm", "Stroma_frac_tm"], "target": 1.0, "tol": 1e-09}, {"id": "shift-delta-sum0", "kind": "sum", "values": ["CTB_delta", "EVT_delta", "Endothelial_cells_delta", "Hofbauer_cells_delta", "Perivascular_delta", "STB_delta", "Stroma_delta"], "target": 0.0, "tol": 1e-09}, {"id": "shift-delta-id-CTB", "kind": "expr", "lhs": "delta", "rhs": "ftm - fft", "tol": 1e-12, "vars": {"delta": "CTB_delta", "ftm": "CTB_frac_tm", "fft": "CTB_frac_ft"}}, {"id": "shift-delta-id-EVT", "kind": "expr", "lhs": "delta", "rhs": "ftm - fft", "tol": 1e-12, "vars": {"delta": "EVT_delta", "ftm": "EVT_frac_tm", "fft": "EVT_frac_ft"}}, {"id": "shift-delta-id-Endothelial_cells", "kind": "expr", "lhs": "delta", "rhs": "ftm - fft", "tol": 1e-12, "vars": {"delta": "Endothelial_cells_delta", "ftm": "Endothelial_cells_frac_tm", "fft": "Endothelial_cells_frac_ft"}}, {"id": "shift-delta-id-Hofbauer_cells", "kind": "expr", "lhs": "delta", "rhs": "ftm - fft", "tol": 1e-12, "vars": {"delta": "Hofbauer_cells_delta", "ftm": "Hofbauer_cells_frac_tm", "fft": "Hofbauer_cells_frac_ft"}}, {"id": "shift-delta-id-Perivascular", "kind": "expr", "lhs": "delta", "rhs": "ftm - fft", "tol": 1e-12, "vars": {"delta": "Perivascular_delta", "ftm": "Perivascular_frac_tm", "fft": "Perivascular_frac_ft"}}, {"id": "shift-delta-id-STB", "kind": "expr", "lhs": "delta", "rhs": "ftm - fft", "tol": 1e-12, "vars": {"delta": "STB_delta", "ftm": "STB_frac_tm", "fft": "STB_frac_ft"}}, {"id": "shift-delta-id-Stroma", "kind": "expr", "lhs": "delta", "rhs": "ftm - fft", "tol": 1e-12, "vars": {"delta": "Stroma_delta", "ftm": "Stroma_frac_tm", "fft": "Stroma_frac_ft"}}], "source": "/mnt/run/jh/projects/tes_agent/results/step-3_composition.csv", "inputs": [{"path": "/mnt/run/jh/projects/tes_agent/results/step-3_composition.csv", "sha256": "4d505b0612213bc8da644bbfb9c5f680431fbea4fb4f46bfc383dd13de5ac6f2"}], "outputs": [{"path": "/mnt