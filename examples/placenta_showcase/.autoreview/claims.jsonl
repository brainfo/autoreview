{"id": "claim-shift-direction", "hash": "c01efd5818f0", "nhash": "f9db858b5482", "ts": "2026-06-10T18:44:23+00:00", "type": "data+interpretation", "claim": "Relative to first trimester, term has a HIGHER fraction of Hofbauer cells (delta=+0.0830, rises) and Stroma (delta=+0.0850) and a LOWER fraction of CTB (delta=-0.0745, falls): the dominant trophoblast compartment shrinks as the villous stroma/macrophage compartment expands toward term. (term 'Hofbaucer cells' normalized to 'Hofbauer cells'; 1 rows renamed.)", "interpretation": "A decline in proliferative cytotrophoblast fraction with relative expansion of Hofbauer (placental macrophage) and stromal populations is consistent with placental maturation from first trimester to term.", "numbers": {"CTB_delta": -0.0745234995276724, "CTB_log2r": -0.297269730777802, "CTB_frac_ft": 0.400214319957136, "CTB_frac_tm": 0.3256908204294636, "Hofbauer_delta": 0.0830371813222412, "Hofbauer_log2r": 0.5891708463353309, "Hofbauer_frac_ft": 0.1646315670736866, "Hofbauer_frac_tm": 0.24766874839592778, "Stroma_delta": 0.08501402288084672, "n_typo_renamed": 1}, "checks": [{"id": "ctb-falls", "kind": "monotonic", "values": ["CTB_frac_tm", "CTB_frac_ft"], "direction": "increasing"}, {"id": "ctb-delta-neg", "kind": "bounds", "values": ["CTB_delta"], "hi": 0}, {"id": "ctb-log2-neg", "kind": "bounds", "values": ["CTB_log2r"], "hi": 0}, {"id": "hofb-rises", "kind": "monotonic", "values": ["Hofbauer_frac_ft", "Hofbauer_frac_tm"], "direction": "increasing"}, {"id": "hofb-delta-pos", "kind": "bounds", "values": ["Hofbauer_delta"], "lo": 0}, {"id": "hofb-log2-pos", "kind": "bounds", "values": ["Hofbauer_log2r"], "lo": 0}, {"id": "typo-renamed", "kind": "equal", "values": ["n_typo_renamed", 1], "tol": 0}], "source": "/mnt/run/jh/projects/tes_agent/results/step-3_composition.csv", "inputs": [{"path": "/mnt/run/jh/projects/tes_agent/results/step-3_composition.csv", "sha256": "4d505b0612213bc8da644bbfb9c5f680431fbea4fb4f46bfc383dd13de5ac6f2"}], "outputs": [{"path": "/mnt/run/jh/projects/tes_agent/results/step-4_composition_shift.csv"}], "search_terms": ["cytotrophoblast decrease term placenta maturation", "Hofbauer cells placental macrophage expansion gestation", "trophoblast stroma proportion first trimester versus term"]}
{"id": "claim-gene-overlap", "hash": "3ad5f265cca7", "nhash": "4bf459acac26", "ts": "2026-06-10T18:44:23+00:00", "type": "data+interpretation", "claim": "The first-trimester 5000-gene HVG set overlaps term's 25777 genes in 3491 genes; using first-trimester's full raw gene set (27526) the overlap with term is 18480 genes (Jaccard 0.5307).", "interpretation": "The datasets use largely overlapping but non-identical gene namespaces; the working-matrix overlap is limited because first trimester is HVG-subset, so cross-dataset gene-level analysis should use the raw/full namespaces.", "numbers": {"hvg_n_set_a": 5000, "hvg_n_set_b": 25777, "hvg_n_intersection": 3491, "hvg_n_union": 27286, "hvg_jaccard": 0.12794106867990912, "raw_n_set_a": 27526, "raw_n_set_b": 25777, "raw_n_intersection": 18480, "raw_n_union": 34823, "raw_jaccard": 0.5306837435028573}, "checks": [{"id": "hvg-inter-le-a", "kind": "monotonic", "values": ["hvg_n_intersection", "hvg_n_set_a"], "direction": "nondecreasing"}, {"id": "hvg-inter-le-b", "kind": "monotonic", "values": ["hvg_n_intersection", "hvg_n_set_b"], "direction": "nondecreasing"}, {"id": "raw-inter-le-a", "kind": "monotonic", "values": ["raw_n_intersection", "raw_n_set_a"], "direction": "nondecreasing"}, {"id": "raw-inter-le-b", "kind": "monotonic", "values": ["raw_n_intersection", "raw_n_set_b"], "direction": "nondecreasing"}, {"id": "hvg-union-id", "kind": "expr", "lhs": "n_union", "rhs": "a + b - inter", "tol": 0, "vars": {"n_union": "hvg_n_union", "a": "hvg_n_set_a", "b": "hvg_n_set_b", "inter": "hvg_n_intersection"}}, {"id": "raw-union-id", "kind": "expr", "lhs": "n_union", "rhs": "a + b - inter", "tol": 0, "vars": {"n_union": "raw_n_union", "a": "raw_n_set_a", "b": "raw_n_set_b", "inter": "raw_n_intersection"}}, {"id": "hvg-jaccard-id", "kind": "expr", "lhs": "jaccard", "rhs": "inter / n_union", "tol": 1e-09, "vars": {"jaccard": "hvg_jaccard", "inter": "hvg_n_intersection", "n_union": "hvg_n_union"}}, {"id": "raw-jaccard-id", "kind": "expr", "lhs": "jaccard", "rhs": "inter / n_union", "tol": 1e-09, "vars": {"jaccard": "raw_jaccard", "inter": "raw_n_intersection", "n_union": "raw_n_union"}}, {"id": "jaccard-bounds", "kind": "bounds", "values": ["hvg_jaccard", "raw_jaccard"], "lo": 0, "hi": 1}, {"id": "raw-inter-ge-hvg-inter", "kind": "monotonic", "values": ["hvg_n_intersection", "raw_n_intersection"], "direction": "increasing"}], "source": "both", "inputs": [{"path": "/mnt/run/jh/projects/tes_agent/first_trimester_final.h5ad", "sha256": "85b09152b2be819023a0b8aa93557f9bc3eed793ed8df253491d651366354ce8"}, {"path": "/mnt/run/jh/projects/tes_agent/term_final.h5ad", "sha256": "888e0acd8a80c5de88a09bb2db3a69df60d94afa0019bb1e4202363842c8a0d3"}], "outputs": [{"path": "/mnt/run/jh/projects/tes_agent/results/step-5_gene_overlap.csv"}], "search_terms": ["gene namespace overlap two single-cell atlases highly variable genes"]}
{"id": "claim-label-overlap", "hash": "25d708c8e64c", "nhash": "0e5af8313bf5", "ts": "2026-06-10T18:44:23+00:00", "type": "data+interpretation", "claim": "After normalizing the Hofbauer spelling, the comparable cell-type label sets are fully shared between first trimester (annotation_withperi) and term (annotate_general): n_shared=7, ft_only=0, term_only=0; shared labels = ['CTB', 'EVT', 'Endothelial cells', 'Hofbauer cells', 'Perivascular', 'STB', 'Stroma'].", "interpretation": "The two atlases were annotated onto a common 7-compartment scheme, which is what makes the step-4 compositional comparison valid.", "numbers": {"n_shared": 7, "n_ft_only": 0, "n_term_only": 0, "n_ft_labels": 7, "n_tm_labels": 7, "shift_n_shared": 7}, "checks": [{"id": "label-ft-partition", "kind": "expr", "lhs": "ft_only + shared", "rhs": "n_ft_labels", "tol": 0, "vars": {"ft_only": "n_ft_only", "shared": "n_shared", "n_ft_labels": "n_ft_labels"}}, {"id": "label-tm-partition", "kind": "expr", "lhs": "tm_only + shared", "rhs": "n_tm_labels", "tol": 0, "vars": {"tm_only": "n_term_only", "shared": "n_shared", "n_tm_labels": "n_tm_labels"}}, {"id": "label-ft-only-zero", "kind": "equal", "values": ["n_ft_only", 0], "tol": 0}, {"id": "label-tm-only-zero", "kind": "equal", "values": ["n_term_only", 0], "tol": 0}, {"id": "label-shared-7", "kind": "equal", "values": ["n_shared", 7], "tol": 0}, {"id": "label-matches-step4", "kind": "equal", "values": ["n_shared", {"claim": "claim-shift-conservation", "key": "n_shared"}], "tol": 0}], "source": "both", "inputs": [{"path": "/mnt/run/jh/projects/tes_agent/first_trimester_final.h5ad", "sha256": "85b09152b2be819023a0b8aa93557f9bc3eed793ed8df253491d651366354ce8"}, {"path": "/mnt/run/jh/projects/tes_agent/term_final.h5ad", "sha256": "888e0acd8a80c5de88a09bb2db3a69df60d94afa0019bb1e4202363842c8a0d3"}], "outputs": [{"path": "/mnt/run/jh/projects/tes_agent/results/step-5_label_overlap.csv"}], "search_terms": ["common cell type annotation scheme placenta compartments"]}
