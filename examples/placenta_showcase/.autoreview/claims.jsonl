{"id": "claim-ft-composition", "hash": "ccadf1ea7b46", "nhash": "5e16294571e8", "ts": "2026-06-10T18:44:23+00:00", "type": "data+interpretation", "claim": "First trimester (annotation) is dominated by CTB (14192 cells, 0.400), followed by Stroma (10446), Hofbauer cells (5838), EVT (2692), STB (1505), Endothelial cells (788); n_annotated=35461.", "interpretation": "CTB (cytotrophoblast) is the single largest population in early placenta, consistent with the proliferative trophoblast compartment of first-trimester villi.", "numbers": {"n_annotated": 35461, "CTB_count": 14192, "CTB_frac": 0.400214319957136, "Stroma_count": 10446, "Stroma_frac": 0.2945771410845718, "Hofbauer_cells_count": 5838, "Hofbauer_cells_frac": 0.1646315670736866, "EVT_count": 2692, "EVT_frac": 0.07591438481712304, "STB_count": 1505, "STB_frac": 0.042440991511801696, "Endothelial_cells_count": 788, "Endothelial_cells_frac": 0.02222159555568089, "sum_frac": 1.0, "sum_count": 35461}, "checks": [{"id": "ft-comp-frac-sum1", "kind": "sum", "values": ["CTB_frac", "Stroma_frac", "Hofbauer_cells_frac", "EVT_frac", "STB_frac", "Endothelial_cells_frac"], "target": 1.0, "tol": 1e-09}, {"id": "ft-comp-frac-bounds", "kind": "bounds", "values": ["CTB_frac", "Stroma_frac", "Hofbauer_cells_frac", "EVT_frac", "STB_frac", "Endothelial_cells_frac"], "lo": 0, "hi": 1}, {"id": "ft-comp-counts-sum", "kind": "equal", "values": ["sum_count", "n_annotated"], "tol": 0}, {"id": "ft-comp-N-eq-ncells", "kind": "equal", "values": ["n_annotated", {"claim": "claim-ft-shape", "key": "n_cells"}], "tol": 0}, {"id": "ft-comp-ctb-max", "kind": "monotonic", "values": ["Stroma_count", "CTB_count"], "direction": "increasing"}, {"id": "ft-comp-ctb-count-id", "kind": "expr", "lhs": "CTB_count", "rhs": "round(CTB_frac*n_annotated)", "tol": 1, "vars": {"CTB_count": "CTB_count", "CTB_frac": "CTB_frac", "n_annotated": "n_annotated"}}], "source": "/mnt/run/jh/projects/tes_agent/first_trimester_final.h5ad", "inputs": [{"path": "/mnt/run/jh/proj