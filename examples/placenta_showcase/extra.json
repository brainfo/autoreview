  {
    "claim": "claim-ft-counts-not-raw",
    "id": "rev-ft-counts-frac-bounds",
    "kind": "bounds",
    "values": ["counts_frac_noninteger", "X_frac_noninteger", "rawX_frac_noninteger"],
