[
  {
    "claim": "claim-ft-shape",
    "id": "rev-ft-counts-nonneg-ints",
    "kind": "bounds",
    "values": ["n_cells", "n_genes", "n_raw_genes", "n_celltypes", "n_celltypes_withperi"],
    "lo": 1,
    "description": "all structural counts are strictly positive"
  },
  {
    "claim": "claim-ft-shape",
    "id": "rev-ft-hvg-le-raw-nonstrict",
    "kind": "monotonic",
